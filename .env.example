# ─────────────────────────────────────────────────────────────────────────────
# Wiskiflix environment. For development, run `npm run setup:dev` (creates .env.local with
# fresh secrets); for production, the server's env file is filled in by hand (Phase 5).
# NEVER commit real values. `.env*` files are git-ignored (except this example).
# The app refuses to boot on missing/invalid values (src/server/env.ts).
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

# NODE_ENV is set by Next.js itself (development for `next dev`, production for the server).

# Canonical origin (absolute URLs, CSRF Origin check, OIDC redirect). No trailing slash.
# production: https://wiski.fun
APP_ORIGIN=http://localhost:3000

# Postgres 17. The app connects as wf_app (DML only); migrations run as wf_migrator.
DATABASE_URL=postgresql://wf_app:CHANGE_ME@localhost:5432/wiskiflix
MIGRATE_DATABASE_URL=postgresql://wf_migrator:CHANGE_ME@localhost:5432/wiskiflix
# Development only: shadow database for `prisma migrate dev` / `npm run db:drift`.
SHADOW_DATABASE_URL=postgresql://wf_migrator:CHANGE_ME@localhost:5432/wiskiflix_shadow

# Redis 7/8 (rate limits, caches, queues).
REDIS_URL=redis://localhost:6379

# ── Secrets: 32 random bytes each, base64url, all different ──────────────────
CSRF_SECRET=CHANGE_ME
COOKIE_SEAL_KEY=CHANGE_ME
# Only while rotating COOKIE_SEAL_KEY (old key, still accepted for unsealing):
COOKIE_SEAL_KEY_PREVIOUS=
IP_HASH_SECRET=CHANGE_ME
# Encrypts the authenticator-app (2FA) secrets. Required in production; changing it means
# every moderator sets the authenticator up again.
TOTP_ENCRYPTION_KEY=CHANGE_ME

# Header with the real client IP, set by nginx from CF-Connecting-IP. Use `none` without a proxy.
CLIENT_IP_HEADER=none

# ── Google sign-in (Q27) ─────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Redirect URIs: http://localhost:3000/api/auth/google/callback and
#                https://wiski.fun/api/auth/google/callback
# Leave both empty to run without login in development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudflare Turnstile ─────────────────────────────────────────────────────
# Empty = Cloudflare's public test keys (development only; refused in production).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Mercado Pago (Phase 2) — TEST credentials only in development ─────────────
# Not secret, but test and production apps have DIFFERENT ids. The access token must belong
# to MP_COLLECTOR_ID (its last "-<digits>" group); the app refuses to boot otherwise.
# Checkout opens only when BOTH the access token and the collector id are set.
# The webhook secret is the "assinatura secreta" of Webhooks › Configurar notificações; without it
# every notification is refused (401) and the worker's reconciliation still picks up payments.
MP_COLLECTOR_ID=
MP_APPLICATION_ID=
# Secrets:
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_SECRET_PREVIOUS=
# Development only: Mercado Pago's test payer, e.g. test_payer@example.com (sent with first name
# "APRO", MP's "approve" test value). Or a test BUYER's e-mail (Contas de teste › comprador,
# test_user_…@testuser.com). With test credentials Mercado Pago refuses any real payer e-mail
# ("Unauthorized use of live credentials"). Refused in production.
MP_TEST_PAYER_EMAIL=

# ── Media (R1) ───────────────────────────────────────────────────────────────
# Processed images (posters, backdrops, title logos). Absolute path; nginx serves it at /media/.
# production: /var/lib/wiski/media (Docker volume, included in backups)
# Empty in development = <project>/.media (served by the app itself).
MEDIA_DIR=

LOG_LEVEL=info
