{
  "name": "wiskiflix",
  "version": "0.1.0",
  "private": true,
  "description": "Wiski — site do streamer (wiski.fun)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:integration && npm run test:brand && npm run test:e2e",
    "brand": "tsx scripts/brand-assets.ts && tsx scripts/logo.ts && tsx scripts/icons.ts && tsx scripts/fonts.ts",
    "brand:assets": "tsx scripts/brand-assets.ts",
    "brand:logo": "tsx scripts/logo.ts",
    "brand:icons": "tsx scripts/icons.ts",
    "brand:fonts": "tsx scripts/fonts.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "check:bundle-secrets": "tsx scripts/check-bundle-secrets.ts",
    "postinstall": "prisma generate",
    "test:brand": "playwright test -c playwright.brand.config.ts",
    "setup:dev": "node scripts/setup-dev-env.mjs",
    "db:seed": "tsx --conditions=react-server scripts/seed-dev.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "ioredis": "6.0.0",
    "next": "16.4.2",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-regexp": "3.3.1",
    "globals": "17.13.0",
    "jose": "6.2.12",
    "opentype.js": "2.0.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "subset-font": "2.9.0",
    "svgo": "4.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    }
  }
}
