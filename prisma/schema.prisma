// ─────────────────────────────────────────────────────────────────────────────
// Wiskiflix — data model (Phase 1 + R1 redesign: docs/phase-0/11-redesign-spec.md §7)
// Target: Prisma ORM 7 (prisma-client generator, prisma.config.ts, @prisma/adapter-pg)
//
// Conventions
//  • IDs: UUIDv7 (time-ordered; public refs use publicCode)
//  • Money: Int, BRL cents ("centavos"). Never Float/Decimal in app code.
//  • Time: timestamptz(3) in UTC. Business calendar = America/Sao_Paulo (applied in code).
//  • Guest checkout: orders may have no user; guests reach their order with a
//    one-time access token (only its SHA-256 is stored).
//  • No card/bank data anywhere. Payment rows hold provider ID, status, amount, timestamps.
//  • Pix QR payloads live only in Redis (TTL = expiry); re-fetched from MP if missing.
//  • Constraints Prisma cannot express live in reviewed SQL migrations
//    (prisma/migrations/*_constraints — CHECKs, partial uniques, audit-log triggers, grants).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  // url is configured in prisma.config.ts (Prisma 7)
}

// ═══════════════════════════ Identity & access ═══════════════════════════════

enum Role {
  USER
  MODERATOR
  STREAMER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED // can read + export own data; cannot post, like, report or sponsor
  DELETED // anonymised (LGPD erasure); row kept for referential integrity
}

model User {
  id                String        @id @default(uuid(7)) @db.Uuid
  googleSub         String        @unique // OIDC `sub` = identity key. Email is NEVER used as identifier.
  email             String // private. Default payer.email for this user's orders.
  emailVerified     Boolean
  username          String?       @unique // lowercase canonical [a-z0-9_]{3,20}; null until onboarding (CHECK)
  usernameChangedAt DateTime?     @db.Timestamptz(3)
  avatarKey         String        @default("perfil-01") // must exist in code registry (Zod enum, src/lib/avatars.ts)
  role              Role          @default(USER)
  isVip             Boolean       @default(false) // perk set by STREAMER in Admin → 10 % discount (not a role)
  /// Badges on the public profile and a place in /ranking (2026-11-04); the viewer can turn it off
  showAchievements  Boolean       @default(true)
  vipSince          DateTime?     @db.Timestamptz(3)
  status            AccountStatus @default(ACTIVE)
  suspendedUntil    DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?     @db.Timestamptz(3)
  /// Authenticator app (TOTP, RFC 6238): AES-256-GCM-encrypted secret, set only once enabled (CHECK).
  totpSecretEnc     Bytes?
  totpEnabledAt     DateTime?     @db.Timestamptz(3)
  /// last accepted 30-s time step — a code is never accepted twice (compare-and-set)
  totpLastStep      BigInt?
  /// bumped when a second factor is removed or the role changes: every "remembered device" stops counting
  mfaEpoch          Int           @default(0)

  sessions           Session[]
  passkeys           Passkey[]
  recoveryCodes      MfaRecoveryCode[]
  usernameHolds      UsernameHold[]
  orders             Order[]
  legalAcceptances   LegalAcceptance[]
  voucherRedemptions VoucherRedemption[]
  reviews            Review[]
  reviewLikes        ReviewLike[]
  reportsFiled       ReviewReport[]      @relation("ReportReporter")
  reportsResolved    ReviewReport[]      @relation("ReportResolver")
  refundsRequested   Refund[]            @relation("RefundRequester")
  catalogItems       CatalogItem[]       @relation("ItemCreator")
  games              Game[]              @relation("GameCreator")
  catalogRevisions   CatalogRevision[]   @relation("RevisionEditor")
  mediaUploads       MediaAsset[]        @relation("MediaUploader")
  campaignsOpened    Campaign[]          @relation("CampaignOpener")
  suggestions        Suggestion[]        @relation("SuggestionAuthor")
  suggestionsDecided Suggestion[]        @relation("SuggestionReviewer")
  seasonReleases     SeasonRelease[]     @relation("ReleaseEditor")
  roletaSpins        RoletaSpin[]        @relation("RoletaSpinner")
  roletaDelivered    RoletaSpin[]        @relation("RoletaDeliverer")

  @@index([role])
}

/// Single-use backup codes for the authenticator app (6 per set). Only an HMAC of each code is stored.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  codeHash  Bytes
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
}

/// Server-side session. Cookie `__Host-wf_session` carries a 256-bit random token; only its SHA-256 is stored.
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  tokenHash     Bytes     @unique
  userId        String    @db.Uuid
  authTime      DateTime  @db.Timestamptz(3) // last interactive Google login → admin step-up (max_age)
  mfaAt         DateTime? @db.Timestamptz(3) // last passkey assertion (admin second factor)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  idleExpiresAt DateTime  @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3) // absolute lifetime
  revokedAt     DateTime? @db.Timestamptz(3)
  uaFamily      String? // coarse ("Chrome · Windows"), shown in "my sessions"; never the raw UA

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// WebAuthn second factor: required for MODERATOR and STREAMER on /admin (11 §9, O6).
/// credentialId/publicKey come from @simplewebauthn/server; signCount regression is rejected.
model Passkey {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  credentialId Bytes     @unique
  publicKey    Bytes
  signCount    BigInt    @default(0)
  transports   String[]
  label        String?
  aaguid       String? // authenticator model (informational)
  backedUp     Boolean   @default(false) // synced passkey (iCloud/Google) vs device-bound
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt   DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Released usernames are held for 30 days so nobody can immediately impersonate the previous owner.
model UsernameHold {
  username   String   @id
  userId     String   @db.Uuid
  releasedAt DateTime @default(now()) @db.Timestamptz(3)
  holdUntil  DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([holdUntil])
}

// ═══════════════════════════ Legal (LGPD / terms) ════════════════════════════

enum LegalDocType {
  TERMS
  PRIVACY
  REFUND
}

/// Legal texts live in the repo (versioned). This row pins version + hash of the exact text shown.
model LegalDocument {
  id          String       @id @default(uuid(7)) @db.Uuid
  type        LegalDocType
  version     String // e.g. "2026-10-01"
  sha256      Bytes
  publishedAt DateTime     @db.Timestamptz(3)
  isCurrent   Boolean      @default(false) // partial unique below: one current per type

  acceptances LegalAcceptance[]

  @@unique([type, version])
  @@unique([type], map: "one_current_legaldoc", where: { isCurrent: true }) // exactly one current text per type
}

/// CHECK (migration SQL): userId IS NOT NULL OR orderId IS NOT NULL — guests accept per order.
model LegalAcceptance {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @db.Uuid
  documentId String   @db.Uuid
  orderId    String?  @db.Uuid
  acceptedAt DateTime @default(now()) @db.Timestamptz(3)

  user     User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  order    Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, documentId])
  @@index([userId])
}

// ═══════════════════════════ Catalog (R1: handpicked, 11 §7) ═════════════════
// Every title, text and image is entered by moderators in /admin/catalogo. No external metadata.

enum ItemKind {
  MOVIE
  SERIES
  FRANCHISE
  /// 2026-11-09: like a series (seasons, episodes, crowdfunded goal), on its own tab
  ANIME
}

/// MOVIE:  DRAFT → ACTIVE → SPONSORED → WATCHED → ARCHIVED
/// SERIES/FRANCHISE: DRAFT → ACTIVE (campaign open/paused) → FUNDED → WATCHED → ARCHIVED
/// "Live" = ACTIVE | SPONSORED | FUNDED | WATCHED: holds a slot (deferred exclusion constraint)
/// and counts towards the 35/10/10 limit (trigger, per-kind advisory lock).
enum ItemStatus {
  DRAFT
  ACTIVE
  SPONSORED
  FUNDED
  WATCHED
  ARCHIVED
}

/// Classificação indicativa (ClassInd): L, 10, 12, 14, 16, 18.
enum AgeRating {
  L
  A10
  A12
  A14
  A16
  A18
}

/// A handpicked movie, series or franchise (replaces Title). Text is sanitised plain text.
model CatalogItem {
  id               String     @id @default(uuid(7)) @db.Uuid
  kind             ItemKind
  slug             String     @unique // [a-z0-9-], from the title; stable public URL
  status           ItemStatus @default(DRAFT)
  slot             Int? // carousel / board position; required while live, planned slot for drafts
  title            String
  originalTitle    String?
  year             Int?
  runtimeMinutes   Int // movie runtime, or total runtime of a series/franchise (scheduling)
  ageRating        AgeRating?
  genres           String[]
  synopsis         String // ≤ 600 chars (CHECK)
  director         String?
  cast             String[]
  seasonsLabel     String? // SERIES: "Temporadas 1–3"
  seasonCount      Int? // SERIES: default goal = R$ 100,00 × seasonCount
  episodeCount     Int?
  trailerYoutubeId String? // [A-Za-z0-9_-]{11} (CHECK); never a URL
  /// MOVIE: draw the title over the poster in the carousel ("Adicionar texto?"); off for posters
  /// that already have the title in the artwork
  posterTitle      Boolean    @default(true)
  /// MOVIE (2026-11-02): price set by hand in the dashboard, replacing the runtime formula (the
  /// base of the price; discounts and queue jumps still apply). null = automatic.
  manualPriceCents Int?
  posterId         String?    @db.Uuid
  backdropId       String?    @db.Uuid
  logoId           String?    @db.Uuid
  reservedUntil    DateTime?  @db.Timestamptz(3) // MOVIE: a pending Pix holds the movie (35 min)
  reservedOrderId  String?    @db.Uuid
  version          Int        @default(0) // optimistic concurrency; = latest CatalogRevision.version
  publishedAt      DateTime?  @db.Timestamptz(3)
  watchedAt        DateTime?  @db.Timestamptz(3)
  /// true: watched by Iara off-stream and logged by hand (2026-11-10); kept out of the live
  /// progress counts and tagged "fora da live" on Assistidos.
  offStream        Boolean    @default(false)
  archivedAt       DateTime?  @db.Timestamptz(3)
  createdById      String     @db.Uuid
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  poster           MediaAsset?       @relation("ItemPoster", fields: [posterId], references: [id], onDelete: Restrict)
  backdrop         MediaAsset?       @relation("ItemBackdrop", fields: [backdropId], references: [id], onDelete: Restrict)
  logo             MediaAsset?       @relation("ItemLogo", fields: [logoId], references: [id], onDelete: Restrict)
  createdBy        User              @relation("ItemCreator", fields: [createdById], references: [id], onDelete: Restrict)
  franchiseEntries FranchiseEntry[]
  revisions        CatalogRevision[]
  campaign         Campaign?
  orders           Order[]
  reviews          Review[]
  watchEvents      WatchEvent[]
  nowPlayingIn     StreamSession[]   @relation("NowPlaying")
  seasonReleases   SeasonRelease[]

  @@index([kind, status, slot])
  @@index([status, watchedAt])
}

/// Films inside a franchise (informational + goal formula: Σ movie price of each film).
model FranchiseEntry {
  id             String @id @default(uuid(7)) @db.Uuid
  franchiseId    String @db.Uuid
  position       Int
  title          String
  year           Int?
  runtimeMinutes Int

  franchise CatalogItem @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@unique([franchiseId, position])
}

/// Every dashboard save (and publish/revert) keeps the full editable state → one-click revert.
model CatalogRevision {
  id        String   @id @default(uuid(7)) @db.Uuid
  itemId    String   @db.Uuid
  version   Int
  snapshot  Json // CatalogSnapshot v1 (Zod-validated on write AND on read)
  note      String // what happened: "save", "publish", "revert:7", "watched" …
  editorId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  item   CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  editor User        @relation("RevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([itemId, version])
}

enum MediaRole {
  POSTER
  BACKDROP
  LOGO
}

/// A processed upload. Only re-encoded variants exist on disk (MEDIA_DIR); the original is deleted.
model MediaAsset {
  id           String    @id @default(uuid(7)) @db.Uuid
  sha256       Bytes     @unique // of the re-encoded master (dedup + file names)
  role         MediaRole
  width        Int
  height       Int
  variants     Json // [{ w, h, format: 'avif' | 'webp', path, bytes }]
  uploadedById String    @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  unusedSince  DateTime? @db.Timestamptz(3) // GC after 30 days

  uploadedBy      User            @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  posterOf        CatalogItem[]   @relation("ItemPoster")
  backdropOf      CatalogItem[]   @relation("ItemBackdrop")
  logoOf          CatalogItem[]   @relation("ItemLogo")
  posterOfRelease SeasonRelease[] @relation("ReleasePoster")
  posterOfSegment LiveSegment[]   @relation("SegmentPoster")
  coverOfGame     Game[]          @relation("GameCover")

  @@index([unusedSince])
}

enum CampaignStatus {
  OPEN
  PAUSED // deadline passed without reaching the goal → waits for the streamer to extend
  FUNDED // "Meta atingida"
  SCHEDULED
  WATCHED
}

/// Crowdfunding for one SERIES / FRANCHISE item. Opened by the STREAMER (goal + deadline, step-up).
/// remainingCents = goal − raised − reserved ≥ 0 (CHECK); conditional decrement prevents overfunding.
model Campaign {
  id             String         @id @default(uuid(7)) @db.Uuid
  itemId         String         @unique @db.Uuid
  goalCents      Int
  raisedCents    Int            @default(0) // confirmed payments
  reservedCents  Int            @default(0) // pending Pix
  remainingCents Int
  supporterCount Int            @default(0) // approved contributions
  deadlineAt     DateTime       @db.Timestamptz(3)
  extensions     Int            @default(0)
  status         CampaignStatus @default(OPEN)
  openedAt       DateTime       @db.Timestamptz(3)
  openedById     String         @db.Uuid
  fundedAt       DateTime?      @db.Timestamptz(3)
  /// Phase 4: the live session a funded campaign starts in (series may run over several lives)
  sessionId      String?        @db.Uuid
  scheduledAt    DateTime?      @db.Timestamptz(3)
  version        Int            @default(0)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  item     CatalogItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  openedBy User           @relation("CampaignOpener", fields: [openedById], references: [id], onDelete: Restrict)
  session  StreamSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  orders   Order[]
  segments LiveSegment[]

  @@index([status, deadlineAt])
  @@index([sessionId])
}

/// Proof an item was watched on stream → unlocks reviews for that item.
model WatchEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  itemId    String   @db.Uuid
  sessionId String?  @db.Uuid
  orderId   String?  @unique @db.Uuid // the movie order that put it on stream (null for campaigns)
  watchedAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  item    CatalogItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  session StreamSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([itemId])
}

// ═══════════════════════════ Pricing ═════════════════════════════════════════

enum RuleSetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Versioned, immutable-once-active pricing config (see 04-pricing-spec.md for the JSON schema).
model PriceRuleSet {
  id          String        @id @default(uuid(7)) @db.Uuid
  version     Int           @unique
  status      RuleSetStatus @default(DRAFT) // partial unique below: exactly one ACTIVE
  config      Json // PricingConfig v1, validated by Zod on write AND on read
  configHash  Bytes // SHA-256 of canonical JSON; pinned by every movie order
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  publishedAt DateTime?     @db.Timestamptz(3)

  orders Order[]

  @@unique([status], map: "one_active_ruleset", where: { status: "ACTIVE" }) // exactly one ACTIVE rule set
}

enum VoucherKind {
  PERCENT
  FIXED
}

model Voucher {
  id               String      @id @default(uuid(7)) @db.Uuid
  code             String      @unique // uppercase canonical, ≥ 8 chars from [A-Z0-9-]
  kind             VoucherKind
  percentBps       Int? // PERCENT: 1..10000 (CHECK)
  amountCents      Int? // FIXED: > 0 (CHECK)
  maxDiscountCents Int?
  minSubtotalCents Int? // vouchers apply to movie orders only (11 §2.1)
  startsAt         DateTime?   @db.Timestamptz(3)
  endsAt           DateTime?   @db.Timestamptz(3)
  maxRedemptions   Int? // null = unlimited
  maxPerUser       Int         @default(1)
  redemptionCount  Int         @default(0) // RESERVED + CONSUMED; guarded by conditional updateMany
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)

  redemptions VoucherRedemption[]
  roletaSpin  RoletaSpin?
}

enum ReservationStatus {
  RESERVED // while Pix is pending
  CONSUMED // payment approved
  RELEASED // expired / cancelled / refunded-before-use
}

model VoucherRedemption {
  id            String            @id @default(uuid(7)) @db.Uuid
  voucherId     String            @db.Uuid
  userId        String?           @db.Uuid // null = guest order (vouchers work for guests, 04 §4)
  buyerKey      String // = Order.buyerKey; maxPerUser is counted per buyer
  orderId       String            @unique @db.Uuid
  status        ReservationStatus @default(RESERVED)
  discountCents Int
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([voucherId, buyerKey, status])
}

/// Fixed queue-jump tiers (e.g. "prioridade" +80 %, "topo" +160 %; defined in PriceRuleSet.config).
/// Cap enforcement without serializable transactions: each reservation claims a free
/// (day, dayIndex) AND (isoWeek, weekIndex) — the indexes are just counters for the shared
/// daily/weekly caps. Unique constraints make over-allocation impossible.
/// Released reservations are DELETED (freeing the index); history lives in Order.breakdown + AuditLog.
model QueueJumpSlot {
  id            String   @id @default(uuid(7)) @db.Uuid
  orderId       String   @unique @db.Uuid
  day           DateTime @db.Date // America/Sao_Paulo calendar day
  tierId        String // tier id from the pinned PriceRuleSet ("prioridade" | "topo" | …)
  dayIndex      Int // 0..dailyCap-1 (CHECK)
  isoWeek       String // "2026-W40"
  weekIndex     Int // 0..weeklyCap-1 (CHECK)
  multiplierBps Int // copied from the tier; 8000..16000 (CHECK)
  confirmed     Boolean  @default(false)
  expiresAt     DateTime @db.Timestamptz(3) // reservation TTL while Pix is pending
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([day, dayIndex])
  @@unique([isoWeek, weekIndex])
  @@index([expiresAt, confirmed])
}

// ═══════════════════════════ Scheduling & orders ═════════════════════════════

enum StreamSessionStatus {
  PLANNED
  LIVE
  DONE
  CANCELLED
}

model StreamSession {
  id              String              @id @default(uuid(7)) @db.Uuid
  startsAt        DateTime            @db.Timestamptz(3)
  endsAt          DateTime?           @db.Timestamptz(3) // set when the live ends (DONE)
  capacityMinutes Int
  bookedMinutes   Int                 @default(0) // movie runtimes scheduled here; conditional updateMany guards capacity
  status          StreamSessionStatus @default(PLANNED)
  publicNote      String? // ≤ 140, sanitised, shown on the public schedule
  startedAt       DateTime?           @db.Timestamptz(3) // went LIVE
  cancelledAt     DateTime?           @db.Timestamptz(3)
  /// Phase 4: what is on screen right now ("Agora assistindo"); only while LIVE (CHECK)
  nowItemId       String?             @db.Uuid
  /// 2026-11-09: the order the dashboard put this session's entries in ("ORDER:<id>",
  /// "CAMPAIGN:<id>", "SEGMENT:<id>"); entries not listed follow in queue order
  entryOrder      String[]            @default([])
  /// 2026-11-09: "Limpar encerradas e canceladas" hides a DONE/CANCELLED session from the
  /// agenda and the Cronograma; the row (and what was watched on it) stays
  hiddenAt        DateTime?           @db.Timestamptz(3)
  version         Int                 @default(0)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  orders      Order[]
  campaigns   Campaign[]
  watchEvents WatchEvent[]
  segments    LiveSegment[]
  nowItem     CatalogItem?  @relation("NowPlaying", fields: [nowItemId], references: [id], onDelete: Restrict)

  /// At most one live session at a time.
  @@unique([status], map: "session_one_live", where: raw("(status = 'LIVE'::\"StreamSessionStatus\")"))
  @@index([startsAt])
}

enum LiveSegmentKind {
  PART // a few episodes of a funded series, or one film of a funded franchise
  EVENT // something else on the live, e.g. "Jogando com os Viewers"
}

enum LiveSegmentStatus {
  SCHEDULED
  PLAYING // "Agora assistindo" (at most one per session, partial unique index)
  DONE
  SKIPPED // the live ended (or was cancelled) before it was shown
}

/// 2026-11-04: what a live carries besides whole movies. A funded series/franchise campaign is
/// watched in parts over several lives — "T1 · E1–E3", "Filme 2: …" — and stays in the queue
/// until the streamer marks its last part ("fim da série"); a custom EVENT has a title and a
/// length only. Minutes count against the session's capacity like a movie's runtime.
model LiveSegment {
  id                String            @id @default(uuid(7)) @db.Uuid
  sessionId         String            @db.Uuid
  kind              LiveSegmentKind
  campaignId        String?           @db.Uuid // PART only (CHECK)
  /// EVENT: the title; PART: what is shown, e.g. "T1 · E1–E3" or "Filme 2: O Retorno"
  label             String
  note              String? // ≤ 140, sanitised, public
  seasonNumber      Int? // PART of a SERIES
  episodeFrom       Int?
  episodeTo         Int?
  /// PART of a FRANCHISE: the film's position in the franchise (FranchiseEntry rows are rewritten
  /// on every catalog save, so the film is kept by position and its title is copied into label)
  franchisePosition Int?
  minutes           Int
  /// shown before everything else on the live (e.g. an event that opens it)
  atStart           Boolean           @default(false)
  status            LiveSegmentStatus @default(SCHEDULED)
  /// EVENT only (2026-11-09): a poster uploaded for the custom event (CHECK)
  posterId          String?           @db.Uuid
  version           Int               @default(0)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  doneAt            DateTime?         @db.Timestamptz(3)

  session  StreamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  campaign Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  poster   MediaAsset?   @relation("SegmentPoster", fields: [posterId], references: [id], onDelete: Restrict)

  /// At most one segment "Agora assistindo" per session.
  @@unique([sessionId], map: "live_segment_one_playing", where: raw("(status = 'PLAYING'::\"LiveSegmentStatus\")"))
  @@index([sessionId, status])
  @@index([campaignId, status])
  @@index([posterId])
}

/// Where an order came from (2026-11-02): the site's Pix checkout, or registered by the streamer
/// as already paid outside the site ("Já pago": no Payment row, no e-mail to anyone).
enum OrderSource {
  CHECKOUT
  MANUAL
}

/// Order lifecycle (shared by movie sponsorships and campaign contributions).
enum OrderStatus {
  PENDING_PAYMENT
  PAID // approved; movie awaiting scheduling / contribution counted
  SCHEDULED
  WATCHING
  COMPLETED
  EXPIRED // Pix not paid before expiry
  CANCELLED
  NEEDS_ATTENTION // late approval after expiry, amount mismatch → streamer decides
  REFUND_PENDING
  REFUNDED
}

enum MessageStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderKind {
  MOVIE // one sponsor pays the full movie price (11 §2.1)
  CONTRIBUTION // any whole-real amount ≥ R$ 5 towards a campaign (11 §2.2)
}

/// The common checkout record (replaces Sponsorship). Kind-specific columns are guarded by
/// CHECKs in the reviewed SQL: MOVIE ⇒ ruleSetId, runtimeMinutes, rescheduleCount set and
/// campaignId NULL; CONTRIBUTION ⇒ campaignId set, whole reais ≥ R$ 5, no perks/queue jump,
/// no session. At most one active MOVIE order per item (partial unique, reviewed SQL).
model Order {
  id                String         @id @default(uuid(7)) @db.Uuid
  publicCode        String         @unique // "WF-7K3Q9X" (Crockford base32). A reference, not a secret.
  kind              OrderKind
  itemId            String         @db.Uuid
  userId            String?        @db.Uuid // null = guest checkout (login not required)
  contactEmail      String // payer.email for MP; receipt + order link. Users: Google e-mail; guests: typed
  /// Who is buying, for caps and limits (05 §5): "u:<userId>" or "e:<sha256 hex of contactEmail>".
  buyerKey          String
  /// Keyed HMAC of the client IP while PENDING_PAYMENT only (≤ 2 pending orders per IP); cleared
  /// on every transition out of PENDING_PAYMENT (CHECK), so it is never kept with paid orders.
  ipKey             String?
  accessTokenHash   Bytes          @unique // SHA-256 of the order access token (guest link / claim)
  claimedAt         DateTime?      @db.Timestamptz(3) // guest order later attached to an account
  // MOVIE only
  runtimeMinutes    Int?
  ruleSetId         String?        @db.Uuid
  sessionId         String?        @db.Uuid
  queueJumpTierId   String? // null = no queue jump
  rescheduleCount   Int?
  // CONTRIBUTION only
  campaignId        String?        @db.Uuid
  // amounts (integer cents)
  breakdown         Json // immutable snapshot of price lines (labels, cents, bps)
  subtotalCents     Int
  discountCents     Int            @default(0)
  queueJumpCents    Int            @default(0)
  totalCents        Int
  sponsorMessage    String? // ≤ 140 chars, sanitised plain text; shown only once APPROVED
  messageStatus     MessageStatus?
  guestDisplayName  String? // guests only, ≤ 24 chars, sanitised; public only once APPROVED
  displayNameStatus MessageStatus?
  showSponsorName   Boolean        @default(true) // false = "Anônimo" everywhere
  /// 2026-11-09: the sponsor ticked "Quero aparecer no mural de apoiadores" (off by default);
  /// a moderator can take it off, never put it back
  wallOptIn         Boolean        @default(false)
  status            OrderStatus    @default(PENDING_PAYMENT)
  source            OrderSource    @default(CHECKOUT)
  clientRequestId   String // Idempotency-Key sent by the browser (double-submit guard)
  version           Int            @default(0) // optimistic concurrency for state transitions
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  paidAt            DateTime?      @db.Timestamptz(3)
  scheduledAt       DateTime?      @db.Timestamptz(3)
  completedAt       DateTime?      @db.Timestamptz(3)
  cancelledAt       DateTime?      @db.Timestamptz(3)

  item              CatalogItem        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  user              User?              @relation(fields: [userId], references: [id], onDelete: Restrict)
  ruleSet           PriceRuleSet?      @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  session           StreamSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  campaign          Campaign?          @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  payment           Payment?
  legalAcceptances  LegalAcceptance[]
  voucherRedemption VoucherRedemption?
  queueJumpSlot     QueueJumpSlot?
  watchEvent        WatchEvent?

  @@unique([contactEmail, clientRequestId])
  /// At most one unpaid order per buyer (05 §9: "max 1 pending order per buyer").
  @@unique([buyerKey], map: "order_one_pending_per_buyer", where: raw("(status = 'PENDING_PAYMENT'::\"OrderStatus\")"))
  /// One sponsor per movie: at most one order that holds or bought the movie (11 §9).
  /// The predicate is written exactly as Postgres normalises it, so the drift check stays empty.
  @@unique([itemId], map: "order_one_active_movie", where: raw("((kind = 'MOVIE'::\"OrderKind\") AND (status = ANY (ARRAY['PENDING_PAYMENT'::\"OrderStatus\", 'PAID'::\"OrderStatus\", 'SCHEDULED'::\"OrderStatus\", 'WATCHING'::\"OrderStatus\", 'COMPLETED'::\"OrderStatus\"])))"))
  @@index([kind, status, sessionId])
  @@index([itemId, status])
  @@index([campaignId, status])
  @@index([userId, createdAt])
  @@index([contactEmail, status])
  @@index([ipKey])
}

// ═══════════════════════════ Payments (Mercado Pago Pix) ═════════════════════

enum PaymentProvider {
  MERCADO_PAGO
}

/// Mirrors MP `status`. Transitions are validated by a state machine; never regress.
enum PaymentStatus {
  PENDING
  APPROVED
  AUTHORIZED
  IN_PROCESS
  IN_MEDIATION
  REJECTED
  CANCELLED
  REFUNDED
  CHARGED_BACK
}

model Payment {
  id                String          @id @default(uuid(7)) @db.Uuid
  orderId           String          @unique @db.Uuid
  provider          PaymentProvider @default(MERCADO_PAGO)
  providerPaymentId String?         @unique // MP payment id; null only between insert and MP response
  idempotencyKey    String          @unique // sent as X-Idempotency-Key on POST /v1/payments
  status            PaymentStatus   @default(PENDING)
  statusDetail      String?
  amountCents       Int
  currency          String          @default("BRL")
  expiresAt         DateTime        @db.Timestamptz(3) // = MP date_of_expiration
  providerUpdatedAt DateTime?       @db.Timestamptz(3) // MP date_last_updated → out-of-order guard
  approvedAt        DateTime?       @db.Timestamptz(3)
  lastSyncedAt      DateTime?       @db.Timestamptz(3)
  version           Int             @default(0)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([status, expiresAt])
}

enum WebhookOutcome {
  RECEIVED
  PROCESSED
  DUPLICATE
  IGNORED // valid signature, but not our payment / irrelevant topic
  FAILED
}

/// One row per verified delivery. Unique x-request-id = replay/duplicate guard.
model WebhookEvent {
  id            String          @id @default(uuid(7)) @db.Uuid
  provider      PaymentProvider
  requestId     String          @unique // x-request-id header
  topic         String // "payment"
  action        String? // "payment.updated"
  resourceId    String // data.id (query string)
  signatureTs   DateTime        @db.Timestamptz(3)
  receivedAt    DateTime        @default(now()) @db.Timestamptz(3)
  processedAt   DateTime?       @db.Timestamptz(3)
  outcome       WebhookOutcome  @default(RECEIVED)
  // The row is also the worker's job (Phase 2): claimed with a lease, retried with backoff.
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now()) @db.Timestamptz(3)
  lockedUntil   DateTime?       @db.Timestamptz(3)

  @@index([resourceId])
  @@index([outcome, nextAttemptAt])
  @@index([receivedAt])
}

enum RefundStatus {
  REQUESTED
  IN_PROCESS
  APPROVED
  REJECTED
}

/// Policy: orders (sponsorships and contributions) are non-refundable. Refunds exist only as a STREAMER-only exception tool
/// (step-up + audit) for payment errors. Final policy text comes from the user's lawyer.
enum RefundReason {
  DUPLICATE_PAYMENT
  PROCESSING_ERROR // e.g. amount mismatch, payment approved for an order that cannot exist
  LEGAL_REQUIREMENT // only if counsel determines a refund is legally required
}

model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  paymentId        String       @db.Uuid
  providerRefundId String?      @unique
  idempotencyKey   String       @unique
  amountCents      Int
  status           RefundStatus @default(REQUESTED)
  reason           RefundReason
  requestedById    String       @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy User    @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([paymentId])
}

// ═══════════════════════════ Reviews & moderation ════════════════════════════

enum ModerationStatus {
  VISIBLE
  AUTO_HIDDEN // report threshold reached; awaiting moderator
  HIDDEN // moderator hid it (author still sees it, with notice)
  REMOVED // removed for policy violation
}

/// Why a review is AUTO_HIDDEN (Phase 3): too many links, or the report threshold (05 §8, Q15).
enum ReviewHoldReason {
  LINKS
  REPORTS
}

model Review {
  id               String            @id @default(uuid(7)) @db.Uuid
  userId           String            @db.Uuid
  itemId           String            @db.Uuid
  rating           Int // 1..5 (CHECK)
  body             String // sanitised plain text, ≤ 2000 chars (CHECK)
  containsSpoilers Boolean           @default(false)
  status           ModerationStatus  @default(VISIBLE)
  likeCount        Int               @default(0) // maintained by the review_like_count trigger (Phase 3 constraints)
  heldReason       ReviewHoldReason? // set exactly when status = AUTO_HIDDEN (CHECK)
  openReportCount  Int               @default(0) // OPEN reports; the increment row-locks the review, serialising the auto-hide count
  moderatedAt      DateTime?         @db.Timestamptz(3) // last moderator action (HIDE/RESTORE/DISMISS/REMOVE)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  editedAt         DateTime?         @db.Timestamptz(3)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  item    CatalogItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  likes   ReviewLike[]
  reports ReviewReport[]

  @@unique([userId, itemId]) // one review per user per watched item (editable)
  @@index([itemId, status, createdAt])
  @@index([itemId, status, likeCount])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([openReportCount])
}

model ReviewLike {
  userId    String   @db.Uuid
  reviewId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId]) // one like per user per review
  @@index([reviewId, createdAt])
}

enum ReportReason {
  UNMARKED_SPOILER
  OFFENSIVE
  HARASSMENT
  HATE_SPEECH
  SPAM
  PERSONAL_DATA
  OFF_TOPIC
  OTHER
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

model ReviewReport {
  id           String       @id @default(uuid(7)) @db.Uuid
  reviewId     String       @db.Uuid
  reporterId   String       @db.Uuid
  reason       ReportReason
  note         String? // ≤ 500 chars, sanitised
  status       ReportStatus @default(OPEN)
  resolvedById String?      @db.Uuid
  resolvedAt   DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  review     Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter   User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User?  @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reviewId, reporterId]) // one report per user per review
  @@index([status, createdAt])
  @@index([reviewId, status])
  @@index([reporterId, createdAt])
}

// ═══════════════════════════ Admin, overlays, media kit ══════════════════════

enum GoalMetric {
  SPONSORSHIP_COUNT
  SPONSORSHIP_REVENUE_CENTS
  WATCHED_MINUTES
}

model Goal {
  id             String     @id @default(uuid(7)) @db.Uuid
  title          String
  metric         GoalMetric
  target         Int
  startsAt       DateTime   @db.Timestamptz(3)
  endsAt         DateTime?  @db.Timestamptz(3)
  active         Boolean    @default(true)
  showOnOverlay  Boolean    @default(true)
  showOnMediaKit Boolean    @default(false)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)
}

/// OBS browser-source credentials. Raw key shown once at creation; only SHA-256 stored.
model OverlayKey {
  id         String    @id @default(uuid(7)) @db.Uuid
  label      String
  keyHash    Bytes     @unique
  keyPrefix  String // first 6 chars, to identify a key in the admin UI
  widgets    String[] // allow-list of widget ids this key may open
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
}

enum Platform {
  TWITCH
  YOUTUBE
  KICK
  TIKTOK
  INSTAGRAM
  X
}

enum StatSource {
  LIVE
  MANUAL
}

/// Last-known-good value per metric → media kit never shows an empty number when an API is down.
model PlatformStat {
  id          String     @id @default(uuid(7)) @db.Uuid
  platform    Platform
  metric      String // "followers", "subscribers", "avg_viewers_30d", ...
  value       BigInt
  source      StatSource
  manualValue BigInt? // streamer override, wins while set
  fetchedAt   DateTime   @db.Timestamptz(3)

  @@unique([platform, metric])
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
  SPAM
}

model ContactMessage {
  id         String        @id @default(uuid(7)) @db.Uuid
  name       String
  email      String
  company    String?
  subject    String
  body       String // sanitised plain text, ≤ 4000 chars
  status     ContactStatus @default(NEW)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  purgeAfter DateTime      @db.Timestamptz(3) // LGPD retention (default 12 months)

  @@index([status, createdAt])
  @@index([purgeAfter])
}

// ═══════════════════════════ Phase 6: links page, suggestions ═══════════════

/// The streamer's "Links" page (a link-in-bio list), in `position` order. https only (CHECK).
model SocialLink {
  id        String   @id @default(uuid(7)) @db.Uuid
  label     String // ≤ 40 chars, sanitised plain text
  note      String? // ≤ 80 chars, a line under the label ("Lives de terça a sábado")
  url       String // https://…, ≤ 300 chars, no credentials (CHECK + app)
  position  Int // 1…30, unique (deferred, so a reorder can permute in one transaction)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

enum SuggestionStatus {
  NEW
  ACCEPTED
  DISMISSED
  WATCHED // "Já assistido" — Iara already watched this title (2026-11-10)
}

/// What a viewer can suggest: the catalog kinds plus GAME (Jogos is its own model, 2026-11-11).
enum SuggestionKind {
  MOVIE
  SERIES
  FRANCHISE
  ANIME
  GAME
}

/// A title a signed-in viewer would like to see on stream. Seen only by moderators and the streamer.
model Suggestion {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @db.Uuid
  kind         SuggestionKind
  title        String // ≤ 120 chars, sanitised plain text
  /// lower-case, accents and punctuation removed: groups the same title across viewers, and one
  /// open suggestion per viewer per title (partial unique)
  titleKey     String
  year         Int?
  note         String? // ≤ 280 chars, sanitised plain text
  status       SuggestionStatus @default(NEW)
  reviewedById String?          @db.Uuid
  reviewedAt   DateTime?        @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  user       User  @relation("SuggestionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("SuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([userId, titleKey], map: "suggestion_one_open_per_title", where: raw("(status = 'NEW'::\"SuggestionStatus\")"))
  @@index([status, createdAt])
  @@index([titleKey])
  @@index([userId, createdAt])
}

/// "Próximas temporadas" on the Cronograma: when the next season of a series comes out. Kept by
/// moderators (Admin › Estreias). A series in the catalog lends its poster and page link; any
/// other series is just a name.
model SeasonRelease {
  id          String   @id @default(uuid(7)) @db.Uuid
  itemId      String?  @db.Uuid // a SERIES in the catalog (optional)
  title       String // ≤ 120 chars, sanitised; the series name
  seasonLabel String // ≤ 40 chars: "Temporada 3", "Parte 2"
  releaseDate DateTime @db.Date // calendar day of the release (no time zone); year-only → Dec 31
  yearOnly    Boolean  @default(false) // only the year is known ("Previsão: 2027")
  note        String? // ≤ 80 chars: "Netflix", "data a confirmar"
  posterId    String?  @db.Uuid // own poster (2:3); else the linked series' poster
  editedById  String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  item     CatalogItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  poster   MediaAsset?  @relation("ReleasePoster", fields: [posterId], references: [id], onDelete: SetNull)
  editedBy User         @relation("ReleaseEditor", fields: [editedById], references: [id], onDelete: Restrict)

  @@index([releaseDate])
  @@index([posterId])
}

model AppSetting {
  key       String   @id // e.g. "orders.open", "queue.paused"
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Append-only. UPDATE/DELETE/TRUNCATE blocked by triggers + GRANTs; id, prevHash and hash are
/// assigned by a BEFORE INSERT trigger under an advisory lock (tamper-evident hash chain, chain
/// order = id order). metadata = allow-listed keys only (no e-mail, IP, Pix payloads or payment data).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now()) @db.Timestamptz(3)
  actorId    String?  @db.Uuid // null = system / worker
  actorRole  Role?
  action     String // "pricing.ruleset.publish", "review.hide", "sponsorship.refund", ...
  targetType String
  targetId   String?
  metadata   Json     @default("{}")
  requestId  String? // correlation id (also in JSON app logs)
  prevHash   Bytes? // set by trigger
  hash       Bytes?   @unique // set by trigger

  @@index([targetType, targetId])
  @@index([actorId, at])
  @@index([action, at])
}

// ── Subathon timer (2026-11-03, docs/phase-6/README.md §10) ──────────────────────────────────────

enum SubathonStatus {
  READY // created, not started: contributions already add time
  RUNNING // counting down: endsAt is the moment it reaches zero
  PAUSED // stopped by the streamer: remainingSeconds holds the time left
  ENDED // finished (reached zero or ended by the streamer); nothing is added any more
}

enum SubathonEntryKind {
  ORDER // a paid site order (movie sponsorship, contribution, "Já pago")
  REFUND // a refunded / charged-back / undone site order: its time taken back
  TIP // StreamElements tip
  BITS // Twitch cheer
  SUB // new Twitch subscription
  RESUB // renewal shared in chat
  PRIME // Prime Gaming subscription
  GIFT // gifted subscription(s): one entry per gift event or per community-gift bomb
  MANUAL // added or removed by the streamer in the dashboard
}

/// A subathon: a countdown that contributions extend. At most one is open (not ENDED): openSlot
/// is 1 while open and NULL once ended (unique). Rates are the R$ value of each stream event,
/// converted with secondsPerReal (base rule R$ 1 = 60 s).
model Subathon {
  id               String          @id @default(uuid(7)) @db.Uuid
  title            String
  status           SubathonStatus  @default(READY)
  openSlot         Int?            @unique @default(1)
  initialSeconds   Int
  /// time left while READY or PAUSED (and when it ended); while RUNNING, see endsAt
  remainingSeconds Int
  endsAt           DateTime?       @db.Timestamptz(3)
  capSeconds       Int?
  secondsPerReal   Int             @default(60)
  /// { bits100Cents, tier1Cents, tier2Cents, tier3Cents, primeCents, count: { site, tips, bits, subs, resubs, prime, gifts } }
  rates            Json
  addedSeconds     Int             @default(0)
  startedAt        DateTime?       @db.Timestamptz(3)
  endedAt          DateTime?       @db.Timestamptz(3)
  version          Int             @default(0)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  entries          SubathonEntry[]
}

/// One contribution to a subathon's timer (the ledger). externalId makes every source idempotent:
/// "order:<id>", "refund:<id>", "se:<activityId>", "manual:<idempotency key>".
model SubathonEntry {
  id             String            @id @default(uuid(7)) @db.Uuid
  subathonId     String            @db.Uuid
  kind           SubathonEntryKind
  externalId     String
  valueCents     Int?
  seconds        Int
  /// what actually moved the timer (seconds clamped by the cap, or by zero when removing time)
  appliedSeconds Int
  /// public text for the overlay and the dashboard log (sanitised plain text)
  label          String?
  orderId        String?           @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  subathon       Subathon          @relation(fields: [subathonId], references: [id], onDelete: Cascade)

  @@unique([subathonId, externalId])
  @@index([subathonId, createdAt])
  @@index([orderId])
}

// ── Roleta (wheel of fortune, 2026-11-04, docs/phase-6/README.md §11) ───────────────────────────

enum RoletaPrize {
  NADA
  FILME // one free movie (delivered by hand: a "Já pago" order)
  DOIS_FILMES // two free movies
  VIP_TWITCH // VIP in the Twitch channel (given by the streamer)
  CUPOM_30 // a personal 30 % coupon (a Voucher, created at once)
}

enum RoletaPrizeStatus {
  PENDING // won, not delivered yet
  DELIVERED // delivered (coupons: at once)
  CANCELLED // withdrawn by the streamer (a coupon's voucher is switched off)
}

/// One spin of the Roleta. A viewer has 5 spins per period; a period starts at 17:00 BRT and
/// `period` is the BRT calendar day it started on. n is 1…5 and (userId, period, n) is unique, so
/// parallel requests can't spin a 6th time. Unused spins don't carry over. "Nada" spins are
/// purged after 30 days; prizes stay.
model RoletaSpin {
  id            String             @id @default(uuid(7)) @db.Uuid
  userId        String             @db.Uuid
  period        DateTime           @db.Date
  n             Int
  prize         RoletaPrize
  /// the wheel slice the wheel stopped on (0…8; each prize has its own slice, "Nada" has five)
  slot          Int
  status        RoletaPrizeStatus? // null exactly for NADA
  voucherId     String?            @unique @db.Uuid // CUPOM_30
  /// the winner's Twitch login (movies and VIP), so the streamer knows who to give it to
  twitchLogin   String?
  deliveredAt   DateTime?          @db.Timestamptz(3)
  deliveredById String?            @db.Uuid
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)

  user        User     @relation("RoletaSpinner", fields: [userId], references: [id], onDelete: Cascade)
  voucher     Voucher? @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  deliveredBy User?    @relation("RoletaDeliverer", fields: [deliveredById], references: [id], onDelete: SetNull)

  @@unique([userId, period, n])
  @@index([status, createdAt])
  @@index([prize, createdAt])
  @@index([deliveredById])
}

// ═══════════════════════════ Jogos (2026-11-09) ═══════════════════════════════

enum GameStatus {
  PLAYING // "Jogando"
  FINISHED // "Zerado"
  DROPPED // "Dropado"
}

/// A game played on stream: a showcase on /jogos (no sponsorship). Added by hand in the dashboard.
/// Text is sanitised plain text; the VOD link is a Twitch or YouTube https URL (CHECK).
model Game {
  id          String     @id @default(uuid(7)) @db.Uuid
  title       String
  platform    String?
  year        Int?
  status      GameStatus @default(PLAYING)
  note        String?
  vodUrl      String?
  coverId     String?    @db.Uuid
  /// "Zerado em" / "Dropado em": a calendar day, optional
  finishedOn  DateTime?  @db.Date
  version     Int        @default(0)
  createdById String     @db.Uuid
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  cover     MediaAsset? @relation("GameCover", fields: [coverId], references: [id], onDelete: Restrict)
  createdBy User        @relation("GameCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, updatedAt])
  @@index([coverId])
}
