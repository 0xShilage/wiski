// ─────────────────────────────────────────────────────────────────────────────
// Wiskiflix — data model (Phase 1 + R1 redesign: docs/phase-0/11-redesign-spec.md §7)
// Target: Prisma ORM 7 (prisma-client generator, prisma.config.ts, @prisma/adapter-pg)
//
// Conventions
//  • IDs: UUIDv7 (time-ordered; public refs use publicCode)
//  • Money: Int, BRL cents ("centavos"). Never Float/Decimal in app code.
//  • Time: timestamptz(3) in UTC. Business calendar = America/Sao_Paulo (applied in code).
//  • Guest checkout: orders may have no user; guests reach their order with a
//    one-time access token (only its SHA-256 is stored).
//  • No card/bank data anywhere. Payment rows hold provider ID, status, amount, timestamps.
//  • Pix QR payloads live only in Redis (TTL = expiry); re-fetched from MP if missing.
//  • Constraints Prisma cannot express live in reviewed SQL migrations
//    (prisma/migrations/*_constraints — CHECKs, partial uniques, audit-log triggers, grants).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  // url is configured in prisma.config.ts (Prisma 7)
}

// ═══════════════════════════ Identity & access ═══════════════════════════════

enum Role {
  USER
  MODERATOR
  STREAMER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED // can read + export own data; cannot post, like, report or sponsor
  DELETED // anonymised (LGPD erasure); row kept for referential integrity
}

model User {
  id                String        @id @default(uuid(7)) @db.Uuid
  googleSub         String        @unique // OIDC `sub` = identity key. Email is NEVER used as identifier.
  email             String // private. Default payer.email for this user's orders.
  emailVerified     Boolean
  username          String?       @unique // lowercase canonical [a-z0-9_]{3,20}; null until onboarding (CHECK)
  usernameChangedAt DateTime?     @db.Timestamptz(3)
  avatarKey         String        @default("mascote-4-lavender") // must exist in code registry (Zod enum)
  role              Role          @default(USER)
  isVip             Boolean       @default(false) // perk set by STREAMER in Admin → 10 % discount (not a role)
  vipSince          DateTime?     @db.Timestamptz(3)
  status            AccountStatus @default(ACTIVE)
  suspendedUntil    DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?     @db.Timestamptz(3)

  sessions           Session[]
  passkeys           Passkey[]
  usernameHolds      UsernameHold[]
  orders             Order[]
  legalAcceptances   LegalAcceptance[]
  voucherRedemptions VoucherRedemption[]
  reviews            Review[]
  reviewLikes        ReviewLike[]
  reportsFiled       ReviewReport[]      @relation("ReportReporter")
  reportsResolved    ReviewReport[]      @relation("ReportResolver")
  refundsRequested   Refund[]            @relation("RefundRequester")
  catalogItems       CatalogItem[]       @relation("ItemCreator")
  catalogRevisions   CatalogRevision[]   @relation("RevisionEditor")
  mediaUploads       MediaAsset[]        @relation("MediaUploader")
  campaignsOpened    Campaign[]          @relation("CampaignOpener")

  @@index([role])
}

/// Server-side session. Cookie `__Host-wf_session` carries a 256-bit random token; only its SHA-256 is stored.
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  tokenHash     Bytes     @unique
  userId        String    @db.Uuid
  authTime      DateTime  @db.Timestamptz(3) // last interactive Google login → admin step-up (max_age)
  mfaAt         DateTime? @db.Timestamptz(3) // last passkey assertion (admin second factor)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  idleExpiresAt DateTime  @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3) // absolute lifetime
  revokedAt     DateTime? @db.Timestamptz(3)
  uaFamily      String? // coarse ("Chrome · Windows"), shown in "my sessions"; never the raw UA

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// WebAuthn second factor: required for MODERATOR and STREAMER on /admin (11 §9, O6).
/// credentialId/publicKey come from @simplewebauthn/server; signCount regression is rejected.
model Passkey {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  credentialId Bytes     @unique
  publicKey    Bytes
  signCount    BigInt    @default(0)
  transports   String[]
  label        String?
  aaguid       String? // authenticator model (informational)
  backedUp     Boolean   @default(false) // synced passkey (iCloud/Google) vs device-bound
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt   DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Released usernames are held for 30 days so nobody can immediately impersonate the previous owner.
model UsernameHold {
  username   String   @id
  userId     String   @db.Uuid
  releasedAt DateTime @default(now()) @db.Timestamptz(3)
  holdUntil  DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([holdUntil])
}

// ═══════════════════════════ Legal (LGPD / terms) ════════════════════════════

enum LegalDocType {
  TERMS
  PRIVACY
  REFUND
}

/// Legal texts live in the repo (versioned). This row pins version + hash of the exact text shown.
model LegalDocument {
  id          String       @id @default(uuid(7)) @db.Uuid
  type        LegalDocType
  version     String // e.g. "2026-10-01"
  sha256      Bytes
  publishedAt DateTime     @db.Timestamptz(3)
  isCurrent   Boolean      @default(false) // partial unique below: one current per type

  acceptances LegalAcceptance[]

  @@unique([type, version])
  @@unique([type], map: "one_current_legaldoc", where: { isCurrent: true }) // exactly one current text per type
}

/// CHECK (migration SQL): userId IS NOT NULL OR orderId IS NOT NULL — guests accept per order.
model LegalAcceptance {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @db.Uuid
  documentId String   @db.Uuid
  orderId    String?  @db.Uuid
  acceptedAt DateTime @default(now()) @db.Timestamptz(3)

  user     User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  order    Order?        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, documentId])
  @@index([userId])
}

// ═══════════════════════════ Catalog (R1: handpicked, 11 §7) ═════════════════
// Every title, text and image is entered by moderators in /admin/catalogo. No external metadata.

enum ItemKind {
  MOVIE
  SERIES
  FRANCHISE
}

/// MOVIE:  DRAFT → ACTIVE → SPONSORED → WATCHED → ARCHIVED
/// SERIES/FRANCHISE: DRAFT → ACTIVE (campaign open/paused) → FUNDED → WATCHED → ARCHIVED
/// "Live" = ACTIVE | SPONSORED | FUNDED | WATCHED: holds a slot (deferred exclusion constraint)
/// and counts towards the 35/10/10 limit (trigger, per-kind advisory lock).
enum ItemStatus {
  DRAFT
  ACTIVE
  SPONSORED
  FUNDED
  WATCHED
  ARCHIVED
}

/// Classificação indicativa (ClassInd): L, 10, 12, 14, 16, 18.
enum AgeRating {
  L
  A10
  A12
  A14
  A16
  A18
}

/// A handpicked movie, series or franchise (replaces Title). Text is sanitised plain text.
model CatalogItem {
  id               String     @id @default(uuid(7)) @db.Uuid
  kind             ItemKind
  slug             String     @unique // [a-z0-9-], from the title; stable public URL
  status           ItemStatus @default(DRAFT)
  slot             Int? // carousel / board position; required while live, planned slot for drafts
  title            String
  originalTitle    String?
  year             Int?
  runtimeMinutes   Int // movie runtime, or total runtime of a series/franchise (scheduling)
  ageRating        AgeRating?
  genres           String[]
  synopsis         String // ≤ 600 chars (CHECK)
  director         String?
  cast             String[]
  seasonsLabel     String? // SERIES: "Temporadas 1–3"
  seasonCount      Int? // SERIES: default goal = R$ 100,00 × seasonCount
  episodeCount     Int?
  trailerYoutubeId String? // [A-Za-z0-9_-]{11} (CHECK); never a URL
  posterId         String?    @db.Uuid
  backdropId       String?    @db.Uuid
  logoId           String?    @db.Uuid
  reservedUntil    DateTime?  @db.Timestamptz(3) // MOVIE: a pending Pix holds the movie (35 min)
  reservedOrderId  String?    @db.Uuid
  version          Int        @default(0) // optimistic concurrency; = latest CatalogRevision.version
  publishedAt      DateTime?  @db.Timestamptz(3)
  watchedAt        DateTime?  @db.Timestamptz(3)
  archivedAt       DateTime?  @db.Timestamptz(3)
  createdById      String     @db.Uuid
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  poster           MediaAsset?       @relation("ItemPoster", fields: [posterId], references: [id], onDelete: Restrict)
  backdrop         MediaAsset?       @relation("ItemBackdrop", fields: [backdropId], references: [id], onDelete: Restrict)
  logo             MediaAsset?       @relation("ItemLogo", fields: [logoId], references: [id], onDelete: Restrict)
  createdBy        User              @relation("ItemCreator", fields: [createdById], references: [id], onDelete: Restrict)
  franchiseEntries FranchiseEntry[]
  revisions        CatalogRevision[]
  campaign         Campaign?
  orders           Order[]
  reviews          Review[]
  watchEvents      WatchEvent[]

  @@index([kind, status, slot])
  @@index([status, watchedAt])
}

/// Films inside a franchise (informational + goal formula: Σ movie price of each film).
model FranchiseEntry {
  id             String @id @default(uuid(7)) @db.Uuid
  franchiseId    String @db.Uuid
  position       Int
  title          String
  year           Int?
  runtimeMinutes Int

  franchise CatalogItem @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@unique([franchiseId, position])
}

/// Every dashboard save (and publish/revert) keeps the full editable state → one-click revert.
model CatalogRevision {
  id        String   @id @default(uuid(7)) @db.Uuid
  itemId    String   @db.Uuid
  version   Int
  snapshot  Json // CatalogSnapshot v1 (Zod-validated on write AND on read)
  note      String // what happened: "save", "publish", "revert:7", "watched" …
  editorId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  item   CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  editor User        @relation("RevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([itemId, version])
}

enum MediaRole {
  POSTER
  BACKDROP
  LOGO
}

/// A processed upload. Only re-encoded variants exist on disk (MEDIA_DIR); the original is deleted.
model MediaAsset {
  id           String    @id @default(uuid(7)) @db.Uuid
  sha256       Bytes     @unique // of the re-encoded master (dedup + file names)
  role         MediaRole
  width        Int
  height       Int
  variants     Json // [{ w, h, format: 'avif' | 'webp', path, bytes }]
  uploadedById String    @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  unusedSince  DateTime? @db.Timestamptz(3) // GC after 30 days

  uploadedBy User          @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  posterOf   CatalogItem[] @relation("ItemPoster")
  backdropOf CatalogItem[] @relation("ItemBackdrop")
  logoOf     CatalogItem[] @relation("ItemLogo")

  @@index([unusedSince])
}

enum CampaignStatus {
  OPEN
  PAUSED // deadline passed without reaching the goal → waits for the streamer to extend
  FUNDED // "Meta atingida"
  SCHEDULED
  WATCHED
}

/// Crowdfunding for one SERIES / FRANCHISE item. Opened by the STREAMER (goal + deadline, step-up).
/// remainingCents = goal − raised − reserved ≥ 0 (CHECK); conditional decrement prevents overfunding.
model Campaign {
  id             String         @id @default(uuid(7)) @db.Uuid
  itemId         String         @unique @db.Uuid
  goalCents      Int
  raisedCents    Int            @default(0) // confirmed payments
  reservedCents  Int            @default(0) // pending Pix
  remainingCents Int
  supporterCount Int            @default(0) // approved contributions
  deadlineAt     DateTime       @db.Timestamptz(3)
  extensions     Int            @default(0)
  status         CampaignStatus @default(OPEN)
  openedAt       DateTime       @db.Timestamptz(3)
  openedById     String         @db.Uuid
  fundedAt       DateTime?      @db.Timestamptz(3)
  version        Int            @default(0)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  item     CatalogItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  openedBy User        @relation("CampaignOpener", fields: [openedById], references: [id], onDelete: Restrict)
  orders   Order[]

  @@index([status, deadlineAt])
}

/// Proof an item was watched on stream → unlocks reviews for that item.
model WatchEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  itemId    String   @db.Uuid
  sessionId String?  @db.Uuid
  orderId   String?  @unique @db.Uuid // the movie order that put it on stream (null for campaigns)
  watchedAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  item    CatalogItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  session StreamSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([itemId])
}

// ═══════════════════════════ Pricing ═════════════════════════════════════════

enum RuleSetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Versioned, immutable-once-active pricing config (see 04-pricing-spec.md for the JSON schema).
model PriceRuleSet {
  id          String        @id @default(uuid(7)) @db.Uuid
  version     Int           @unique
  status      RuleSetStatus @default(DRAFT) // partial unique below: exactly one ACTIVE
  config      Json // PricingConfig v1, validated by Zod on write AND on read
  configHash  Bytes // SHA-256 of canonical JSON; pinned by every movie order
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  publishedAt DateTime?     @db.Timestamptz(3)

  orders Order[]

  @@unique([status], map: "one_active_ruleset", where: { status: "ACTIVE" }) // exactly one ACTIVE rule set
}

enum VoucherKind {
  PERCENT
  FIXED
}

model Voucher {
  id               String      @id @default(uuid(7)) @db.Uuid
  code             String      @unique // uppercase canonical, ≥ 8 chars from [A-Z0-9-]
  kind             VoucherKind
  percentBps       Int? // PERCENT: 1..10000 (CHECK)
  amountCents      Int? // FIXED: > 0 (CHECK)
  maxDiscountCents Int?
  minSubtotalCents Int? // vouchers apply to movie orders only (11 §2.1)
  startsAt         DateTime?   @db.Timestamptz(3)
  endsAt           DateTime?   @db.Timestamptz(3)
  maxRedemptions   Int? // null = unlimited
  maxPerUser       Int         @default(1)
  redemptionCount  Int         @default(0) // RESERVED + CONSUMED; guarded by conditional updateMany
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)

  redemptions VoucherRedemption[]
}

enum ReservationStatus {
  RESERVED // while Pix is pending
  CONSUMED // payment approved
  RELEASED // expired / cancelled / refunded-before-use
}

/// Guests may use vouchers too (04 §4 step 5), so limits count per buyer: `buyerKey` is the
/// order's buyer ("u:<userId>" or "e:<sha256 of the normalised contact e-mail>").
model VoucherRedemption {
  id            String            @id @default(uuid(7)) @db.Uuid
  voucherId     String            @db.Uuid
  userId        String?           @db.Uuid
  buyerKey      String
  orderId       String            @unique @db.Uuid
  status        ReservationStatus @default(RESERVED)
  discountCents Int
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([voucherId, buyerKey, status])
}

/// Fixed queue-jump tiers (e.g. "prioridade" +80 %, "topo" +160 %; defined in PriceRuleSet.config).
/// Cap enforcement without serializable transactions: each reservation claims a free
/// (day, dayIndex) AND (isoWeek, weekIndex) — the indexes are just counters for the shared
/// daily/weekly caps. Unique constraints make over-allocation impossible.
/// Released reservations are DELETED (freeing the index); history lives in Order.breakdown + AuditLog.
model QueueJumpSlot {
  id            String   @id @default(uuid(7)) @db.Uuid
  orderId       String   @unique @db.Uuid
  day           DateTime @db.Date // America/Sao_Paulo calendar day
  tierId        String // tier id from the pinned PriceRuleSet ("prioridade" | "topo" | …)
  dayIndex      Int // 0..dailyCap-1 (CHECK)
  isoWeek       String // "2026-W40"
  weekIndex     Int // 0..weeklyCap-1 (CHECK)
  /// 0..tier.dailyCap-1 for tiers with their own daily cap ("topo": 1/day); null otherwise.
  /// unique (day, tierId, tierIndex) makes the per-tier cap race-free like the shared caps.
  tierIndex     Int?
  multiplierBps Int // copied from the tier; 8000..16000 (CHECK)
  confirmed     Boolean  @default(false)
  expiresAt     DateTime @db.Timestamptz(3) // reservation TTL while Pix is pending
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([day, dayIndex])
  @@unique([isoWeek, weekIndex])
  @@unique([day, tierId, tierIndex])
  @@index([expiresAt, confirmed])
}

// ═══════════════════════════ Scheduling & orders ═════════════════════════════

enum StreamSessionStatus {
  PLANNED
  LIVE
  DONE
  CANCELLED
}

model StreamSession {
  id              String              @id @default(uuid(7)) @db.Uuid
  startsAt        DateTime            @db.Timestamptz(3)
  endsAt          DateTime?           @db.Timestamptz(3)
  capacityMinutes Int
  bookedMinutes   Int                 @default(0) // conditional updateMany guards capacity
  status          StreamSessionStatus @default(PLANNED)
  publicNote      String?
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  orders      Order[]
  watchEvents WatchEvent[]

  @@index([startsAt])
}

/// Order lifecycle (shared by movie sponsorships and campaign contributions).
enum OrderStatus {
  PENDING_PAYMENT
  PAID // approved; movie awaiting scheduling / contribution counted
  SCHEDULED
  WATCHING
  COMPLETED
  EXPIRED // Pix not paid before expiry
  CANCELLED
  NEEDS_ATTENTION // late approval after expiry, amount mismatch → streamer decides
  REFUND_PENDING
  REFUNDED
}

/// Why an order needs the streamer (13 D4). Kept after it is resolved, as history.
enum AttentionReason {
  LATE_APPROVAL // paid after we expired/cancelled it (the movie or the campaign room may be gone)
  AMOUNT_MISMATCH // MP amount/currency/method differs from the order
  ACCOUNT_MISMATCH // collector / application / live mode differs from ours
  CHARGEBACK // the payer disputed an approved payment
  REFUNDED_OUTSIDE // an approved payment was refunded in Mercado Pago's panel, not through /admin
}

enum MessageStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderKind {
  MOVIE // one sponsor pays the full movie price (11 §2.1)
  CONTRIBUTION // any whole-real amount ≥ R$ 5 towards a campaign (11 §2.2)
}

/// The common checkout record (replaces Sponsorship). Kind-specific columns are guarded by
/// CHECKs in the reviewed SQL: MOVIE ⇒ ruleSetId, runtimeMinutes, rescheduleCount set and
/// campaignId NULL; CONTRIBUTION ⇒ campaignId set, whole reais ≥ R$ 5, no perks/queue jump,
/// no session. At most one active MOVIE order per item (partial unique, reviewed SQL).
model Order {
  id                String         @id @default(uuid(7)) @db.Uuid
  publicCode        String         @unique // "WF-7K3Q9X" (Crockford base32). A reference, not a secret.
  kind              OrderKind
  itemId            String         @db.Uuid
  userId            String?        @db.Uuid // null = guest checkout (login not required)
  contactEmail      String // payer.email for MP; receipt + order link. Users: Google e-mail; guests: typed
  /// "u:<userId>" or "e:<hex sha256 of contactEmail>" — one pending order per buyer (partial
  /// unique), per-buyer voucher and queue-jump limits. Never shown.
  buyerKey          String
  accessTokenHash   Bytes          @unique // SHA-256 of the order access token (guest link / claim)
  claimedAt         DateTime?      @db.Timestamptz(3) // guest order later attached to an account
  // MOVIE only
  runtimeMinutes    Int?
  ruleSetId         String?        @db.Uuid
  sessionId         String?        @db.Uuid
  queueJumpTierId   String? // null = no queue jump
  rescheduleCount   Int?
  // CONTRIBUTION only
  campaignId        String?        @db.Uuid
  // amounts (integer cents)
  breakdown         Json // immutable snapshot of price lines (labels, cents, bps)
  subtotalCents     Int
  discountCents     Int            @default(0)
  queueJumpCents    Int            @default(0)
  totalCents        Int
  sponsorMessage    String? // ≤ 140 chars, sanitised plain text; shown only once APPROVED
  messageStatus     MessageStatus?
  guestDisplayName  String? // guests only, ≤ 24 chars, sanitised; public only once APPROVED
  displayNameStatus MessageStatus?
  showSponsorName   Boolean        @default(true) // false = "Anônimo" everywhere
  status            OrderStatus    @default(PENDING_PAYMENT)
  attentionReason   AttentionReason? // set with NEEDS_ATTENTION (CHECK), kept as history
  clientRequestId   String // Idempotency-Key sent by the browser (double-submit guard)
  version           Int            @default(0) // optimistic concurrency for state transitions
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  paidAt            DateTime?      @db.Timestamptz(3)
  scheduledAt       DateTime?      @db.Timestamptz(3)
  completedAt       DateTime?      @db.Timestamptz(3)
  cancelledAt       DateTime?      @db.Timestamptz(3)

  item              CatalogItem        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  user              User?              @relation(fields: [userId], references: [id], onDelete: Restrict)
  ruleSet           PriceRuleSet?      @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  session           StreamSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  campaign          Campaign?          @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  payment           Payment?
  legalAcceptances  LegalAcceptance[]
  voucherRedemption VoucherRedemption?
  queueJumpSlot     QueueJumpSlot?
  watchEvent        WatchEvent?
  emails            EmailOutbox[]

  @@unique([contactEmail, clientRequestId])
  /// One unpaid order per buyer at a time (04 §5 fairness): a second checkout gets 409.
  @@unique([buyerKey], map: "order_one_pending_per_buyer", where: raw("(status = 'PENDING_PAYMENT'::\"OrderStatus\")"))
  /// One sponsor per movie: at most one order that holds or bought the movie (11 §9).
  /// The predicate is written exactly as Postgres normalises it, so the drift check stays empty.
  @@unique([itemId], map: "order_one_active_movie", where: raw("((kind = 'MOVIE'::\"OrderKind\") AND (status = ANY (ARRAY['PENDING_PAYMENT'::\"OrderStatus\", 'PAID'::\"OrderStatus\", 'SCHEDULED'::\"OrderStatus\", 'WATCHING'::\"OrderStatus\", 'COMPLETED'::\"OrderStatus\"])))"))
  @@index([kind, status, sessionId])
  @@index([itemId, status])
  @@index([campaignId, status])
  @@index([userId, createdAt])
  @@index([contactEmail, status])
  @@index([buyerKey, createdAt])
}

// ═══════════════════════════ Payments (Mercado Pago Pix) ═════════════════════

enum PaymentProvider {
  MERCADO_PAGO
}

/// Mirrors MP `status`. Transitions are validated by a state machine; never regress.
enum PaymentStatus {
  PENDING
  APPROVED
  AUTHORIZED
  IN_PROCESS
  IN_MEDIATION
  REJECTED
  CANCELLED
  REFUNDED
  CHARGED_BACK
}

/// Phase 2 uses Mercado Pago's Orders API (13 D1): one MP order per Order, holding one Pix
/// payment. `status` is OUR forward-only state; MP's raw status/status_detail sit next to it.
model Payment {
  id                String          @id @default(uuid(7)) @db.Uuid
  orderId           String          @unique @db.Uuid
  provider          PaymentProvider @default(MERCADO_PAGO)
  providerOrderId   String?         @unique // MP order id ("ORD…"); null only until MP answers
  providerPaymentId String?         @unique // MP payment id inside that order ("PAY…")
  idempotencyKey    String          @unique // sent as X-Idempotency-Key on POST /v1/orders
  status            PaymentStatus   @default(PENDING)
  providerStatus    String? // MP order status as received ("action_required", "processed", …)
  statusDetail      String? // MP status_detail as received
  amountCents       Int
  currency          String          @default("BRL")
  expiresAt         DateTime        @db.Timestamptz(3) // = MP date_of_expiration
  providerUpdatedAt DateTime?       @db.Timestamptz(3) // MP date_last_updated → out-of-order guard
  approvedAt        DateTime?       @db.Timestamptz(3)
  lastSyncedAt      DateTime?       @db.Timestamptz(3)
  version           Int             @default(0)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([status, expiresAt])
}

enum WebhookOutcome {
  RECEIVED
  PROCESSED
  DUPLICATE
  IGNORED // valid signature, but not our payment / irrelevant topic
  FAILED
}

/// One row per verified delivery. Unique x-request-id = replay/duplicate guard (Redis SETNX in front).
model WebhookEvent {
  id          String          @id @default(uuid(7)) @db.Uuid
  provider    PaymentProvider
  requestId   String          @unique // x-request-id header
  topic       String // "payment"
  action      String? // "payment.updated"
  resourceId  String // data.id (query string)
  signatureTs DateTime        @db.Timestamptz(3)
  receivedAt  DateTime        @default(now()) @db.Timestamptz(3)
  processedAt DateTime?       @db.Timestamptz(3)
  outcome     WebhookOutcome  @default(RECEIVED)

  @@index([resourceId])
}

enum RefundStatus {
  REQUESTED
  IN_PROCESS
  APPROVED
  REJECTED
}

/// Policy: orders (sponsorships and contributions) are non-refundable. Refunds exist only as a STREAMER-only exception tool
/// (step-up + audit) for payment errors. Final policy text comes from the user's lawyer.
enum RefundReason {
  DUPLICATE_PAYMENT
  PROCESSING_ERROR // e.g. amount mismatch, payment approved for an order that cannot exist
  LEGAL_REQUIREMENT // only if counsel determines a refund is legally required
}

model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  paymentId        String       @db.Uuid
  providerRefundId String?      @unique
  idempotencyKey   String       @unique
  amountCents      Int
  status           RefundStatus @default(REQUESTED)
  reason           RefundReason
  requestedById    String       @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy User    @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([paymentId])
}

// ═══════════════════════════ Transactional e-mail (Phase 2) ══════════════════

enum EmailTemplate {
  ORDER_RECEIPT // after the payment is approved — never before (01 §3.2)
  CAMPAIGN_EXTENDED // the streamer extended a campaign this buyer contributed to
  CAMPAIGN_FUNDED // the campaign reached its goal
}

enum EmailStatus {
  HELD // waiting for an event (the receipt waits for the approval)
  PENDING
  SENT
  FAILED // gave up after retries
  CANCELLED // order expired/cancelled before approval
}

/// Outbox: rows are written in the same transaction as the event that causes them; the worker
/// sends them. The recipient is resolved from the order at send time — the address is never
/// copied here. `sealedToken` (receipt only) carries the order link token sealed with
/// COOKIE_SEAL_KEY until the receipt is sent, then it is erased.
model EmailOutbox {
  id                String        @id @default(uuid(7)) @db.Uuid
  template          EmailTemplate
  orderId           String        @db.Uuid
  campaignId        String?       @db.Uuid
  dedupeKey         String        @unique // e.g. "receipt:<orderId>", "extended:<campaignId>:3:<orderId>"
  status            EmailStatus   @default(PENDING)
  sealedToken       String?
  attempts          Int           @default(0)
  nextAttemptAt     DateTime      @default(now()) @db.Timestamptz(3)
  lastError         String? // short code only (no addresses, no provider bodies)
  providerMessageId String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  sentAt            DateTime?     @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([orderId])
}

// ═══════════════════════════ Reviews & moderation ════════════════════════════

enum ModerationStatus {
  VISIBLE
  AUTO_HIDDEN // report threshold reached; awaiting moderator
  HIDDEN // moderator hid it (author still sees it, with notice)
  REMOVED // removed for policy violation
}

model Review {
  id               String           @id @default(uuid(7)) @db.Uuid
  userId           String           @db.Uuid
  itemId           String           @db.Uuid
  rating           Int // 1..5 (CHECK)
  body             String // sanitised plain text, ≤ 2000 chars (CHECK)
  containsSpoilers Boolean          @default(false)
  status           ModerationStatus @default(VISIBLE)
  likeCount        Int              @default(0) // maintained in the same tx as ReviewLike writes
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  editedAt         DateTime?        @db.Timestamptz(3)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  item    CatalogItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  likes   ReviewLike[]
  reports ReviewReport[]

  @@unique([userId, itemId]) // one review per user per watched item (editable)
  @@index([itemId, status, createdAt])
  @@index([userId, createdAt])
}

model ReviewLike {
  userId    String   @db.Uuid
  reviewId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId]) // one like per user per review
  @@index([reviewId])
}

enum ReportReason {
  UNMARKED_SPOILER
  OFFENSIVE
  HARASSMENT
  HATE_SPEECH
  SPAM
  PERSONAL_DATA
  OFF_TOPIC
  OTHER
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

model ReviewReport {
  id           String       @id @default(uuid(7)) @db.Uuid
  reviewId     String       @db.Uuid
  reporterId   String       @db.Uuid
  reason       ReportReason
  note         String? // ≤ 500 chars, sanitised
  status       ReportStatus @default(OPEN)
  resolvedById String?      @db.Uuid
  resolvedAt   DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  review     Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter   User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User?  @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reviewId, reporterId]) // one report per user per review
  @@index([status, createdAt])
}

// ═══════════════════════════ Admin, overlays, media kit ══════════════════════

enum GoalMetric {
  SPONSORSHIP_COUNT
  SPONSORSHIP_REVENUE_CENTS
  WATCHED_MINUTES
}

model Goal {
  id             String     @id @default(uuid(7)) @db.Uuid
  title          String
  metric         GoalMetric
  target         Int
  startsAt       DateTime   @db.Timestamptz(3)
  endsAt         DateTime?  @db.Timestamptz(3)
  active         Boolean    @default(true)
  showOnOverlay  Boolean    @default(true)
  showOnMediaKit Boolean    @default(false)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)
}

/// OBS browser-source credentials. Raw key shown once at creation; only SHA-256 stored.
model OverlayKey {
  id         String    @id @default(uuid(7)) @db.Uuid
  label      String
  keyHash    Bytes     @unique
  keyPrefix  String // first 6 chars, to identify a key in the admin UI
  widgets    String[] // allow-list of widget ids this key may open
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
}

enum Platform {
  TWITCH
  YOUTUBE
  KICK
  TIKTOK
  INSTAGRAM
  X
}

enum StatSource {
  LIVE
  MANUAL
}

/// Last-known-good value per metric → media kit never shows an empty number when an API is down.
model PlatformStat {
  id          String     @id @default(uuid(7)) @db.Uuid
  platform    Platform
  metric      String // "followers", "subscribers", "avg_viewers_30d", ...
  value       BigInt
  source      StatSource
  manualValue BigInt? // streamer override, wins while set
  fetchedAt   DateTime   @db.Timestamptz(3)

  @@unique([platform, metric])
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
  SPAM
}

model ContactMessage {
  id         String        @id @default(uuid(7)) @db.Uuid
  name       String
  email      String
  company    String?
  subject    String
  body       String // sanitised plain text, ≤ 4000 chars
  status     ContactStatus @default(NEW)
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)
  purgeAfter DateTime      @db.Timestamptz(3) // LGPD retention (default 12 months)

  @@index([status, createdAt])
  @@index([purgeAfter])
}

model AppSetting {
  key       String   @id // e.g. "orders.open", "queue.paused"
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Append-only. UPDATE/DELETE/TRUNCATE blocked by triggers + GRANTs; id, prevHash and hash are
/// assigned by a BEFORE INSERT trigger under an advisory lock (tamper-evident hash chain, chain
/// order = id order). metadata = allow-listed keys only (no e-mail, IP, Pix payloads or payment data).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now()) @db.Timestamptz(3)
  actorId    String?  @db.Uuid // null = system / worker
  actorRole  Role?
  action     String // "pricing.ruleset.publish", "review.hide", "sponsorship.refund", ...
  targetType String
  targetId   String?
  metadata   Json     @default("{}")
  requestId  String? // correlation id (also in JSON app logs)
  prevHash   Bytes? // set by trigger
  hash       Bytes?   @unique // set by trigger

  @@index([targetType, targetId])
  @@index([actorId, at])
  @@index([action, at])
}
