# Browser-test front (Phase 5): only the process-level settings differ from production
# (temp paths, one unprivileged prefix). The site is the PRODUCTION template,
# docker/nginx/templates/wiskiflix.conf.template, rendered by tests/e2e/support/stack.ts with
# test values; Cloudflare's real-IP list and Authenticated Origin Pulls are the only snippets
# replaced (no Cloudflare in front of the tests).
worker_processes 1;
pid __TMP__/nginx.pid;
error_log __TMP__/nginx-error.log warn;
events { worker_connections 512; }

http {
  include __MIME__;
  default_type application/octet-stream;
  server_tokens off;
  access_log off;
  client_body_temp_path __TMP__/body;
  proxy_temp_path __TMP__/proxy;
  fastcgi_temp_path __TMP__/fastcgi;
  uwsgi_temp_path __TMP__/uwsgi;
  scgi_temp_path __TMP__/scgi;

  include __SITE__;
}
