# Phase 1/R1 test front: production-like nginx in front of the standalone Next.js server.
# Phase 5 replaces this with docker/nginx/conf.d/wiskiflix.conf (Cloudflare real_ip, mTLS, …);
# the security-header snippet included here is the real one.
worker_processes 1;
pid __TMP__/nginx.pid;
error_log __TMP__/nginx-error.log warn;
events { worker_connections 256; }

http {
  server_tokens off;
  access_log off;
  client_body_temp_path __TMP__/body;
  proxy_temp_path __TMP__/proxy;
  fastcgi_temp_path __TMP__/fastcgi;
  uwsgi_temp_path __TMP__/uwsgi;
  scgi_temp_path __TMP__/scgi;

  client_max_body_size 16k;
  client_body_timeout 10s;
  client_header_timeout 10s;
  large_client_header_buffers 4 8k;

  limit_req_zone $binary_remote_addr zone=wf_upload:1m rate=2r/m;

  upstream app { server 127.0.0.1:__APP_PORT__; keepalive 8; }

  server {
    listen 127.0.0.1:__HTTPS_PORT__ ssl;
    server_name localhost;
    ssl_certificate __TMP__/cert.pem;
    ssl_certificate_key __TMP__/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;       # Phase 5: real_ip from CF-Connecting-IP
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 15s;

    location /api/ready { deny all; }

    # Content-hashed build assets: immutable. Cache headers here are owned by nginx.
    location /_next/static/ {
      include __SNIPPET__;
      proxy_hide_header Cache-Control;
      add_header Cache-Control "public, max-age=31536000, immutable" always;
      proxy_pass http://app;
    }
    # Brand files keep stable names (not hashed) → long but not immutable.
    location /brand/ {
      include __SNIPPET__;
      proxy_hide_header Cache-Control;
      add_header Cache-Control "public, max-age=604800, stale-while-revalidate=86400" always;
      proxy_pass http://app;
    }

    # R1: processed images, straight from MEDIA_DIR (never proxied).
    location /media/ {
      alias __MEDIA_DIR__/;
      include __SNIPPET__;
      include __MEDIA_SNIPPET__;
    }
    # R1: the only location with bodies > 16 KB.
    location = /api/v1/admin/media {
      include __SNIPPET__;
      include __UPLOAD_SNIPPET__;
      proxy_pass http://app;
    }

    # Phase 2: live order/campaign updates (SSE) — streamed, idle timeout above the 20 s heartbeat.
    location ~ ^/api/v1/(orders/WF-[0-9A-Z]{6}|campaigns/[0-9a-f-]{36})/events$ {
      include __SNIPPET__;
      include __SSE_SNIPPET__;
      proxy_pass http://app;
    }
    # Phase 2: Mercado Pago notifications (05 §6): small JSON only.
    location = /api/webhooks/mercadopago {
      include __SNIPPET__;
      client_max_body_size 16k;
      proxy_pass http://app;
    }

    location / {
      include __SNIPPET__;
      proxy_pass http://app;
    }
  }
}
